rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    
    function isTrainer() {
      return isSignedIn() &&
             (request.auth.token.email == 'youssf.rehem@revibe.me' ||
              (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer'));
    }
    
    function isTrainerOrOwner(uid) {
      return isTrainer() || isOwner(uid);
    }

    // Revibe staff (care / management) — any @revibe.me account.
    function isRevibe() {
      return isSignedIn() &&
             request.auth.token.email is string &&
             request.auth.token.email.lower().matches('.*@revibe[.]me$');
    }

    // Partner type ('seller' / 'repair') picked by a non-Revibe user.
    function myPartnerType() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('partnerType', '');
    }

    // Revibe team ('tickets' / 'inbound' / 'claims' / 'operations' /
    // 'management'), set by trainers only.
    function myTeam() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('team', '');
    }

    // Trainers and the management team see everything. Other Revibe agents
    // see docs tagged 'revibe' (or legacy docs with no tags, which meant
    // Revibe-only); partners only see docs whose `audiences` include their
    // partner type.
    function canSeeAudiences(data) {
      return isTrainer() ||
             (isRevibe() && myTeam() == 'management') ||
             (isRevibe() && ('revibe' in data.get('audiences', []) || data.get('audiences', []).size() == 0)) ||
             (isSignedIn() && !isRevibe() && myPartnerType() in data.get('audiences', []));
    }

    // ============================================
    // Users Collection
    // ============================================
    match /users/{userId} {
      // Anyone authenticated can read user profiles
      allow read: if isSignedIn();
      
      // Users can create their own profile — never as a trainer (except the
      // admin), and partnerType, if set, must be valid.
      allow create: if isOwner(userId) &&
                       request.resource.data.uid == userId &&
                       !('team' in request.resource.data) &&
                       (request.resource.data.get('role', 'trainee') == 'trainee' ||
                        request.auth.token.email == 'youssf.rehem@revibe.me') &&
                       request.resource.data.get('partnerType', 'seller') in ['seller', 'repair'];
      
      // Trainers can update any user's profile (including role/promotions).
      // Owners can update their own profile but NOT their own role.
      // Partners may set partnerType once (when unset), and Revibe staff may
      // set their team once (any team but management); after that only a
      // trainer can change either.
      // Explicit parentheses so precedence is unambiguous.
      allow update: if isTrainer() ||
                       (isOwner(userId) &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) &&
                        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['team']) ||
                         (isRevibe() &&
                          resource.data.get('team', null) == null &&
                          request.resource.data.team in ['tickets', 'inbound', 'claims', 'operations'])) &&
                        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['partnerType']) ||
                         (resource.data.get('partnerType', null) == null &&
                          request.resource.data.partnerType in ['seller', 'repair'])));
      
      // Only trainers can delete users
      allow delete: if isTrainer();
    }

    // ============================================
    // Materials Collection
    // ============================================
    match /materials/{materialId} {
      // Revibe staff + trainers read all; partners only materials tagged for them
      allow read: if canSeeAudiences(resource.data);
      
      // Only trainers can create, update, or delete materials
      allow create, update, delete: if isTrainer();
    }

    // ============================================
    // Categories (name + partner audiences)
    // ============================================
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTrainer();
    }

    // ============================================
    // Annotations Collection
    // ============================================
    match /annotations/{annotationId} {
      // Everyone authenticated can read annotations
      allow read: if isSignedIn();
      
      // Only trainers can create, update, or delete annotations
      allow create, update, delete: if isTrainer();
    }

    // ============================================
    // Progress Collection
    // ============================================
    match /progress/{progressId} {
      // Users can read their own progress
      // Trainers can read all progress records
      // (resource == null lets a get() on a not-yet-created doc resolve
      // instead of erroring on resource.data)
      allow read: if isSignedIn() &&
                     (resource == null ||
                      resource.data.uid == request.auth.uid ||
                      isTrainer());
      
      // Users can create/update their own progress
      // Document ID must match pattern: {uid}_{materialId}
      allow create: if isSignedIn() && 
                       request.resource.data.uid == request.auth.uid &&
                       progressId == request.auth.uid + '_' + request.resource.data.materialId;
      
      allow update: if isSignedIn() &&
                       resource.data.uid == request.auth.uid &&
                       request.resource.data.uid == request.auth.uid &&
                       progressId == request.auth.uid + '_' + request.resource.data.materialId;

      // Only trainers can delete progress records
      allow delete: if isTrainer();
    }

    // ============================================
    // Feedback Collection
    // ============================================
    match /feedback/{feedbackId} {
      // Feedback is private: only the author or a trainer can read it.
      // (resource == null lets the pre-submit get() on a not-yet-created
      // doc resolve instead of erroring on resource.data — which was
      // blocking trainees' first feedback submission.)
      allow read: if isSignedIn() &&
                     (resource == null ||
                      resource.data.uid == request.auth.uid ||
                      isTrainer());

      // Users can create/update their own feedback
      // Document ID must match pattern: {uid}_{materialId}
      allow create: if isSignedIn() &&
                       request.resource.data.uid == request.auth.uid &&
                       feedbackId == request.auth.uid + '_' + request.resource.data.materialId &&
                       request.resource.data.rating is number &&
                       request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       (!('comment' in request.resource.data) ||
                        request.resource.data.comment.size() <= 500);

      allow update: if isSignedIn() &&
                       resource.data.uid == request.auth.uid &&
                       request.resource.data.uid == request.auth.uid &&
                       feedbackId == request.auth.uid + '_' + request.resource.data.materialId &&
                       request.resource.data.rating is number &&
                       request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       (!('comment' in request.resource.data) ||
                        request.resource.data.comment.size() <= 500);
      
      // Only trainers can delete feedback
      allow delete: if isTrainer();
    }

    // ============================================
    // Material Updates (update notifications)
    // ============================================
    match /materialUpdates/{updateId} {
      // Same audience gating as materials
      allow read: if canSeeAudiences(resource.data);
      // Only trainers can create update notification records
      allow create: if isTrainer();
      // No update or delete needed
      allow update, delete: if false;
    }

    // ============================================
    // Notification Dismissals (per-user seen list)
    // ============================================
    match /notificationDismissals/{userId} {
      // Users can only read and write their own dismissal record
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // ============================================
    // Deny all other collections by default
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
